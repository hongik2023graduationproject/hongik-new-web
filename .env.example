# hongik-web 환경 변수 예시
# apps/playground (Next.js) 기준. 변수는 NEXT_PUBLIC_ 접두사가 있으면 클라이언트 번들에 포함된다는 점에 유의.

# 백엔드 API는 없다 — 코드 실행은 브라우저 WASM, 공유 링크는 URL 프래그먼트(#code=)로 처리한다.

# ────────────────────────────────────
# 사이트 URL (선택)
# ────────────────────────────────────

# robots.txt / sitemap.xml의 절대 URL. 미설정 시 https://hongik.tolelom.xyz.
# NEXT_PUBLIC_SITE_URL=https://hongik.tolelom.xyz

# ────────────────────────────────────
# 빌드 설정
# ────────────────────────────────────

# Next.js 환경. production 빌드 시 dev 도구 비활성, source map 처리 변경.
NODE_ENV=production

# ────────────────────────────────────
# 관측 (선택 — TBD)
# ────────────────────────────────────

# Sentry 통합 아직 미구현. env var만 예약.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=     # source map 업로드용, 서버 전용
